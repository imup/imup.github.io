{
  "animSpecs": [
    { "name": "attributeName", "type": "text" },
    { "name": "attributeType", "type": "select", "options": ["", "auto", "CSS", "XML"] },
    { "name": "type", "type": "select", "options": ["", "translate", "rotate", "scale", "skewX", "skewY"] },
    { "name": "from", "type": "text" },
    { "name": "to", "type": "text" },
    { "name": "by", "type": "text" },
    { "name": "values", "type": "textarea" },
    { "name": "path", "type": "textarea" },
    { "name": "dur", "type": "text" },
    { "name": "begin", "type": "text" },
    { "name": "end", "type": "text" },
    { "name": "repeatCount", "type": "text" },
    { "name": "repeatDur", "type": "text" },
    { "name": "calcMode", "type": "select", "options": ["", "discrete", "linear", "paced", "spline"] },
    { "name": "keyTimes", "type": "text" },
    { "name": "keySplines", "type": "text" },
    { "name": "keyPoints", "type": "text" },
    { "name": "fill", "type": "select", "options": ["", "remove", "freeze"] },
    { "name": "additive", "type": "select", "options": ["", "replace", "sum"] },
    { "name": "accumulate", "type": "select", "options": ["", "none", "sum"] },
    { "name": "rotate", "type": "text" }
  ],

  "posAttrs": {
    "rect":     ["x", "y", "width", "height", "rx", "ry"],
    "circle":   ["cx", "cy", "r"],
    "ellipse":  ["cx", "cy", "rx", "ry"],
    "line":     ["x1", "y1", "x2", "y2"],
    "image":    ["x", "y", "width", "height"],
    "use":      ["x", "y", "width", "height"],
    "text":     ["x", "y", "dx", "dy"],
    "tspan":    ["x", "y", "dx", "dy"],
    "path":     ["d"],
    "polyline": ["points"],
    "polygon":  ["points"]
  },

  "posAttrTextarea": ["d", "points"],

  "pathLengthTags": [
    "rect", "circle", "ellipse", "line", "image", "use",
    "text", "tspan", "path", "polyline", "polygon"
  ],

  "fillSpecs": [
    { "name": "fill", "type": "color" },
    { "name": "fill-opacity", "type": "number", "step": 0.1, "min": 0, "max": 1 },
    { "name": "fill-rule", "type": "select", "options": ["", "nonzero", "evenodd"] },
    { "name": "stroke", "type": "color" },
    { "name": "stroke-width", "type": "number" },
    { "name": "stroke-opacity", "type": "number", "step": 0.1, "min": 0, "max": 1 },
    { "name": "stroke-linecap", "type": "select", "options": ["", "butt", "round", "square"] },
    { "name": "stroke-linejoin", "type": "select", "options": ["", "miter", "round", "bevel"] },
    { "name": "stroke-miterlimit", "type": "number" },
    {
      "name": "stroke-dasharray",
      "type": "text",
      "presets": [
        { "labelKey": "field.presetSolid", "value": "" },
        { "labelKey": "field.presetDashed44", "value": "4 4" },
        { "labelKey": "field.presetDotted14", "value": "1 4" },
        { "labelKey": "field.presetDashDot", "value": "6 3 2 3" },
        { "labelKey": "field.presetLongDash", "value": "8 4" }
      ]
    },
    { "name": "stroke-dashoffset", "type": "number" },
    { "name": "opacity", "type": "number", "step": 0.1, "min": 0, "max": 1 }
  ],

  "strokeAdvSpecs": [
    { "name": "vector-effect", "type": "select", "options": ["", "none", "non-scaling-stroke"] },
    { "name": "paint-order", "type": "select", "options": ["", "normal", "stroke", "markers", "fill", "stroke markers", "fill markers", "fill stroke"] }
  ],

  "refSpecs": [
    { "name": "filter", "defTag": "filter", "onCreate": "filter" },
    { "name": "clip-path", "defTag": "clipPath" },
    { "name": "mask", "defTag": "mask" },
    { "name": "marker-start", "defTag": "marker", "onCreate": "marker" },
    { "name": "marker-mid", "defTag": "marker", "onCreate": "marker" },
    { "name": "marker-end", "defTag": "marker", "onCreate": "marker" }
  ],

  "refUnitSpecs": [
    { "name": "clipPathUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "maskUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "maskContentUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "mask-type", "type": "select", "options": ["", "luminance", "alpha"] }
  ],

  "renderSpecs": [
    { "name": "visibility", "type": "select", "options": ["", "visible", "hidden", "collapse"] },
    { "name": "display", "type": "select", "options": ["", "inline", "block", "none"] },
    { "name": "overflow", "type": "select", "options": ["", "visible", "hidden", "scroll", "auto"] },
    { "name": "shape-rendering", "type": "select", "options": ["", "auto", "optimizeSpeed", "crispEdges", "geometricPrecision"] },
    { "name": "text-rendering", "type": "select", "options": ["", "auto", "optimizeSpeed", "optimizeLegibility", "geometricPrecision"] },
    { "name": "image-rendering", "type": "select", "options": ["", "auto", "optimizeQuality", "optimizeSpeed", "pixelated", "smooth", "high-quality", "crisp-edges"] },
    { "name": "color-interpolation", "type": "select", "options": ["", "auto", "sRGB", "linearRGB"] },
    { "name": "mix-blend-mode", "type": "select", "options": ["", "normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion", "hue", "saturation", "color", "luminosity"] },
    { "name": "isolation", "type": "select", "options": ["", "auto", "isolate"] }
  ],

  "interactSpecs": [
    { "name": "class", "type": "text" },
    { "name": "pointer-events", "type": "select", "options": ["", "auto", "none", "visiblePainted", "visibleFill", "visibleStroke", "visible", "painted", "fill", "stroke", "all"] },
    { "name": "cursor", "type": "select", "options": ["", "auto", "default", "pointer", "move", "crosshair", "text", "wait", "help", "grab", "grabbing"] }
  ],

  "textBaseSpecs": [
    { "name": "text-anchor", "type": "select", "options": ["", "start", "middle", "end"] },
    { "name": "font-family", "type": "text" },
    { "name": "font-size", "type": "number" },
    { "name": "font-weight", "type": "select", "options": ["", "normal", "bold", "100", "200", "300", "400", "500", "600", "700", "800", "900"] },
    { "name": "font-style", "type": "select", "options": ["", "normal", "italic", "oblique"] },
    { "name": "letter-spacing", "type": "text" }
  ],

  "textAdvSpecs": [
    { "name": "dominant-baseline", "type": "select", "options": ["", "auto", "text-before-edge", "text-after-edge", "middle", "central", "hanging", "alphabetic", "ideographic", "mathematical", "inherit"] },
    { "name": "alignment-baseline", "type": "select", "options": ["", "auto", "baseline", "before-edge", "text-before-edge", "middle", "central", "after-edge", "text-after-edge", "ideographic", "alphabetic", "hanging", "mathematical", "inherit"] },
    { "name": "text-decoration", "type": "select", "options": ["", "none", "underline", "overline", "line-through"] },
    { "name": "textLength", "type": "number" },
    { "name": "lengthAdjust", "type": "select", "options": ["", "spacing", "spacingAndGlyphs"] },
    { "name": "word-spacing", "type": "text" },
    { "name": "writing-mode", "type": "select", "options": ["", "horizontal-tb", "vertical-rl", "vertical-lr"] },
    { "name": "font-stretch", "type": "select", "options": ["", "normal", "ultra-condensed", "extra-condensed", "condensed", "semi-condensed", "semi-expanded", "expanded", "extra-expanded", "ultra-expanded"] },
    { "name": "xml:space", "type": "select", "options": ["", "default", "preserve"] }
  ],

  "transformSpecs": [
    { "key": "tx",    "labelKey": "field.translateX", "step": 1,   "animKey": "translate-tx" },
    { "key": "ty",    "labelKey": "field.translateY", "step": 1,   "animKey": "translate-ty" },
    { "key": "rot",   "labelKey": "field.rotation",   "step": 1,   "animKey": "rotate" },
    { "key": "rotCx", "labelKey": "field.rotCenterX", "step": 1 },
    { "key": "rotCy", "labelKey": "field.rotCenterY", "step": 1 },
    { "key": "scale", "labelKey": "field.scale",      "step": 0.1, "min": 0, "animKey": "scale" },
    { "key": "skewX", "labelKey": "field.skewX",      "step": 1 },
    { "key": "skewY", "labelKey": "field.skewY",      "step": 1 }
  ],

  "canvasPresets": [
    { "key": "ratio16_9", "mode": "ratio", "ratio": 1.7778 },
    { "key": "ratio4_3",  "mode": "ratio", "ratio": 1.3333 },
    { "key": "ratio1_1",  "mode": "ratio", "ratio": 1 },
    { "key": "a4",        "mode": "fixed", "width": 794, "height": 1123 },
    { "key": "size24",    "mode": "square", "size": 24 },
    { "key": "size32",    "mode": "square", "size": 32 },
    { "key": "size64",    "mode": "square", "size": 64 },
    { "key": "size128",   "mode": "square", "size": 128 },
    { "key": "size256",   "mode": "square", "size": 256 }
  ],

  "presetColors": [
    "#000000", "#ffffff", "#64748b", "#94a3b8", "#ef4444", "#f97316",
    "#f59e0b", "#eab308", "#22c55e", "#14b8a6", "#3b82f6", "#8b5cf6"
  ],

  "vbLabels": ["minX", "minY", "width", "height"],

  "parOptions": [
    "", "xMidYMid meet", "xMidYMid slice", "none",
    "xMinYMin meet", "xMinYMin slice",
    "xMidYMin meet", "xMidYMin slice",
    "xMaxYMin meet", "xMaxYMin slice",
    "xMinYMid meet", "xMinYMid slice",
    "xMaxYMid meet", "xMaxYMid slice",
    "xMinYMax meet", "xMinYMax slice",
    "xMidYMax meet", "xMidYMax slice",
    "xMaxYMax meet", "xMaxYMax slice"
  ],

  "shapes": {
    "order": ["rect", "roundrect", "circle", "ellipse", "triangle", "polygon", "star", "line", "polyline"],
    "builders": {
      "rect":      { "kind": "rect",         "defaults": { "sizeRatio": 1.0 } },
      "roundrect": { "kind": "rect",         "defaults": { "sizeRatio": 1.0, "rxRatio": 0.08 } },
      "circle":    { "kind": "circle",       "defaults": { "radiusRatio": 0.5 } },
      "ellipse":   { "kind": "ellipse",      "defaults": { "rxRatio": 0.5, "ryRatio": 0.35 } },
      "triangle":  { "kind": "polygon",      "defaults": { "sides": 3, "radiusRatio": 0.5 } },
      "polygon":   { "kind": "polygon",      "defaults": { "sides": 6, "radiusRatio": 0.5 } },
      "star":      { "kind": "polygon-star", "defaults": { "points": 5, "ratio": 0.45, "radiusRatio": 0.5 } },
      "line":      { "kind": "line",         "defaults": { "lengthRatio": 1.0 } },
      "polyline":  { "kind": "polyline",     "defaults": { "sizeRatio": 1.0 } }
    }
  },

  "animTemplates": {
    "order": ["fade", "rotate", "scale", "translate", "color", "stroke", "motion", "pulse", "custom"],
    "builders": {
      "fade":      { "kind": "animate",          "attrs": { "attributeName": "opacity", "values": "1;0;1", "dur": "2s", "repeatCount": "indefinite" } },
      "rotate":    { "kind": "animateTransform", "dynamic": "rotateCenter", "attrs": { "attributeName": "transform", "type": "rotate", "dur": "4s", "repeatCount": "indefinite" } },
      "scale":     { "kind": "animateTransform", "attrs": { "attributeName": "transform", "type": "scale", "values": "1;1.2;1", "dur": "2s", "repeatCount": "indefinite" } },
      "translate": { "kind": "animateTransform", "attrs": { "attributeName": "transform", "type": "translate", "values": "0,0;20,0;0,0", "dur": "2s", "repeatCount": "indefinite" } },
      "color":     { "kind": "animate",          "attrs": { "attributeName": "fill", "values": "#ff0000;#00ff00;#ff0000", "dur": "3s", "repeatCount": "indefinite" } },
      "stroke":    { "kind": "animate",          "attrs": { "attributeName": "stroke-dashoffset", "from": "100", "to": "0", "dur": "2s", "fill": "freeze" } },
      "motion":    { "kind": "animateMotion",    "attrs": { "path": "M0,0 C 20,-20 40,20 60,0", "dur": "4s", "repeatCount": "indefinite" } },
      "pulse":     { "kind": "animate",          "attrs": { "attributeName": "opacity", "values": "1;0.4;1", "dur": "1s", "repeatCount": "indefinite" } },
      "custom":    { "kind": "animate",          "attrs": { "attributeName": "", "dur": "2s", "repeatCount": "indefinite" }, "isCustom": true }
    }
  },

  "fieldAnims": {
    "x":                 { "kind": "valuePulse", "delta": 20 },
    "y":                 { "kind": "valuePulse", "delta": 20 },
    "cx":                { "kind": "valuePulse", "delta": 20 },
    "cy":                { "kind": "valuePulse", "delta": 20 },
    "x1":                { "kind": "valuePulse", "delta": 20 },
    "y1":                { "kind": "valuePulse", "delta": 20 },
    "x2":                { "kind": "valuePulse", "delta": 20 },
    "y2":                { "kind": "valuePulse", "delta": 20 },
    "dx":                { "kind": "valuePulse", "delta": 10 },
    "dy":                { "kind": "valuePulse", "delta": 10 },
    "width":             { "kind": "scalePulse", "factor": 1.3 },
    "height":            { "kind": "scalePulse", "factor": 1.3 },
    "r":                 { "kind": "scalePulse", "factor": 1.3 },
    "rx":                { "kind": "scalePulse", "factor": 1.3 },
    "ry":                { "kind": "scalePulse", "factor": 1.3 },
    "fill":              { "kind": "colorLoop" },
    "stroke":            { "kind": "colorLoop" },
    "opacity":           { "kind": "opacityPulse" },
    "fill-opacity":      { "kind": "opacityPulse" },
    "stroke-opacity":    { "kind": "opacityPulse" },
    "stroke-width":      { "kind": "scalePulse", "factor": 2 },
    "stroke-dashoffset": { "kind": "dashoffset" },
    "font-size":         { "kind": "scalePulse", "factor": 1.3 }
  },

  "filterPrimitives": {
    "order": ["feGaussianBlur", "feDropShadow", "feOffset", "feBlend", "feColorMatrix", "feTurbulence", "feComposite", "feMerge"],
    "defs": {
      "feGaussianBlur": {
        "fields": [{ "name": "stdDeviation", "type": "text", "default": "3", "placeholder": "3", "full": true }]
      },
      "feDropShadow": {
        "fields": [
          { "name": "dx", "type": "number", "default": 2 },
          { "name": "dy", "type": "number", "default": 2 },
          { "name": "stdDeviation", "type": "number", "default": 3 },
          { "name": "flood-color", "type": "color", "default": "#000000" },
          { "name": "flood-opacity", "type": "number", "default": 0.5, "step": 0.1 }
        ]
      },
      "feOffset": {
        "fields": [
          { "name": "dx", "type": "number", "default": 4 },
          { "name": "dy", "type": "number", "default": 4 }
        ]
      },
      "feBlend": {
        "fields": [
          { "name": "mode", "type": "select", "options": ["normal","multiply","screen","overlay","darken","lighten"], "default": "normal" },
          { "name": "in",  "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "in2", "type": "text", "default": "", "placeholder": "in2" }
        ]
      },
      "feColorMatrix": {
        "fields": [
          { "name": "type", "type": "select", "options": ["matrix","saturate","hueRotate","luminanceToAlpha"], "default": "saturate" },
          { "name": "values", "type": "text", "default": "0.5", "placeholder": "0.5", "full": true }
        ]
      },
      "feTurbulence": {
        "fields": [
          { "name": "baseFrequency", "type": "text", "default": "0.05", "placeholder": "0.05" },
          { "name": "numOctaves", "type": "number", "default": 2 },
          { "name": "type", "type": "select", "options": ["fractalNoise","turbulence"], "default": "fractalNoise" }
        ]
      },
      "feComposite": {
        "fields": [
          { "name": "operator", "type": "select", "options": ["over","in","out","atop","xor"], "default": "over" },
          { "name": "in",  "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "in2", "type": "text", "default": "", "placeholder": "in2" }
        ]
      },
      "feMerge": {
        "fields": [{ "name": "inputs", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic, blur", "full": true }]
      }
    }
  },

  "markerPresets": {
    "order": ["triangle", "circle", "vee"],
    "defs": {
      "triangle": {
        "viewBox": "0 0 10 10",
        "refX": 10, "refY": 5, "size": 10,
        "markup": "<path d=\"M0,0 L10,5 L0,10 z\" fill=\"{color}\"/>"
      },
      "circle": {
        "viewBox": "0 0 10 10",
        "refX": 5, "refY": 5, "size": 10,
        "markup": "<circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"{color}\"/>"
      },
      "vee": {
        "viewBox": "0 0 10 10",
        "refX": 8, "refY": 5, "size": 10,
        "markup": "<path d=\"M2,2 L8,5 L2,8\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>"
      }
    }
  }
}