{
  "panelLayout": [
    { "type": "special", "hook": "animPanel", "tags": ["animate", "animatetransform", "animatemotion", "animatecolor", "set"], "exclusive": true },
    { "type": "special", "hook": "imagePreview", "tags": ["image"] },
    { "type": "special", "hook": "gradientEdit", "tags": ["linearGradient", "radialGradient"] },
    { "type": "special", "hook": "filterEdit", "tags": ["filter"] },
    { "type": "group", "source": "posAttrs", "titleKey": "group.position", "when": "hasSpecs" },
    { "type": "transform" },
    { "type": "group", "source": "fillSpecs", "titleKey": "group.appearance" },
    { "type": "group", "source": "strokeAdvSpecs", "titleKey": "group.strokeAdvanced" },
    { "type": "group", "source": "refSpecs+refUnitSpecs", "titleKey": "group.reference" },
    { "type": "group", "source": "renderSpecs", "titleKey": "group.render" },
    { "type": "group", "source": "interactSpecs", "titleKey": "group.interact" },
    { "type": "special", "hook": "textContent", "tags": ["text", "tspan", "textPath"] },
    { "type": "group", "source": "textBaseSpecs", "titleKey": "group.text", "tags": ["text", "tspan", "textPath"] },
    { "type": "group", "source": "textAdvSpecs", "titleKey": "group.textAdv", "tags": ["text", "tspan", "textPath"] },
    { "type": "group", "source": "textPathSpecs", "titleKey": "group.textPath", "tags": ["textPath"] },
    { "type": "group", "source": "aSpecs", "titleKey": "group.link", "tags": ["a"] },
    { "type": "group", "source": "patternSpecs", "titleKey": "group.pattern", "tags": ["pattern"] },
    { "type": "group", "source": "symbolSpecs", "titleKey": "group.symbol", "tags": ["symbol"] },
    { "type": "group", "source": "viewSpecs", "titleKey": "group.view", "tags": ["view"] },
    { "type": "group", "source": "switchSpecs", "titleKey": "group.switch", "tags": ["switch"] },
    { "type": "childAnims" },
    { "type": "structure", "when": "!isReadOnly" }
  ],

  "animSpecs": [
    { "name": "attributeName", "type": "text" },
    { "name": "attributeType", "type": "select", "options": ["", "auto", "CSS", "XML"] },
    { "name": "type", "type": "select", "options": ["", "translate", "rotate", "scale", "skewX", "skewY"] },
    { "name": "from", "type": "text", "sliders": "fromto" },
    { "name": "to", "type": "text", "sliders": "fromto" },
    { "name": "by", "type": "text" },
    { "name": "values", "type": "textarea", "sliders": "values" },
    { "name": "path", "type": "textarea" },
    { "name": "dur", "type": "text" },
    { "name": "begin", "type": "text" },
    { "name": "end", "type": "text" },
    { "name": "repeatCount", "type": "text" },
    { "name": "repeatDur", "type": "text" },
    { "name": "calcMode", "type": "select", "options": ["", "discrete", "linear", "paced", "spline"] },
    { "name": "keyTimes", "type": "text" },
    { "name": "keySplines", "type": "text" },
    { "name": "keyPoints", "type": "text" },
    { "name": "fill", "type": "select", "options": ["", "remove", "freeze"] },
    { "name": "additive", "type": "select", "options": ["", "replace", "sum"] },
    { "name": "accumulate", "type": "select", "options": ["", "none", "sum"] },
    { "name": "rotate", "type": "text" },
    { "name": "min", "type": "text" },
    { "name": "max", "type": "text" }
  ],

  "posAttrs": {
    "rect": ["x", "y", "width", "height", "rx", "ry"],
    "circle": ["cx", "cy", "r"],
    "ellipse": ["cx", "cy", "rx", "ry"],
    "line": ["x1", "y1", "x2", "y2"],
    "image": ["x", "y", "width", "height"],
    "foreignObject": ["x", "y", "width", "height"],
    "use": ["x", "y", "width", "height"],
    "text": ["x", "y", "dx", "dy"],
    "tspan": ["x", "y", "dx", "dy"],
    "textPath": ["startOffset"],
    "path": ["d"],
    "polyline": ["points"],
    "polygon": ["points"],
    "stop": [
      { "name": "offset", "type": "text", "animatable": true },
      { "name": "stop-color", "type": "color", "animatable": true },
      { "name": "stop-opacity", "type": "number", "step": 0.1, "min": 0, "max": 1, "animatable": true }
    ]
  },

  "posAttrTextarea": ["d", "points", "startOffset"],

  "pathLengthTags": [
    "rect", "circle", "ellipse", "line", "image", "use",
    "text", "tspan", "textPath", "path", "polyline", "polygon"
  ],

  "fillSpecs": [
    { "name": "fill", "type": "color", "animatable": true },
    { "name": "fill-opacity", "type": "number", "step": 0.1, "min": 0, "max": 1, "animatable": true },
    { "name": "fill-rule", "type": "select", "options": ["", "nonzero", "evenodd"], "animatable": true },
    { "name": "stroke", "type": "color", "animatable": true },
    { "name": "stroke-width", "type": "number", "animatable": true },
    { "name": "stroke-opacity", "type": "number", "step": 0.1, "min": 0, "max": 1, "animatable": true },
    { "name": "stroke-linecap", "type": "select", "options": ["", "butt", "round", "square"], "animatable": true },
    { "name": "stroke-linejoin", "type": "select", "options": ["", "miter", "round", "bevel"], "animatable": true },
    { "name": "stroke-miterlimit", "type": "number", "animatable": true },
    {
      "name": "stroke-dasharray",
      "type": "text",
      "animatable": true,
      "presets": [
        { "labelKey": "field.presetSolid", "value": "" },
        { "labelKey": "field.presetDashed44", "value": "4 4" },
        { "labelKey": "field.presetDotted14", "value": "1 4" },
        { "labelKey": "field.presetDashDot", "value": "6 3 2 3" },
        { "labelKey": "field.presetLongDash", "value": "8 4" }
      ]
    },
    { "name": "stroke-dashoffset", "type": "number", "animatable": true },
    { "name": "opacity", "type": "number", "step": 0.1, "min": 0, "max": 1, "animatable": true }
  ],

  "strokeAdvSpecs": [
    { "name": "vector-effect", "type": "select", "options": ["", "none", "non-scaling-stroke"] },
    { "name": "paint-order", "type": "select", "options": ["", "normal", "stroke", "markers", "fill", "stroke markers", "fill markers", "fill stroke"] }
  ],

  "refSpecs": [
    { "name": "filter", "defTag": "filter", "onCreate": "filter", "animatable": true },
    { "name": "clip-path", "defTag": "clipPath", "animatable": true },
    { "name": "mask", "defTag": "mask", "animatable": true },
    { "name": "marker-start", "defTag": "marker", "onCreate": "marker", "animatable": true },
    { "name": "marker-mid", "defTag": "marker", "onCreate": "marker", "animatable": true },
    { "name": "marker-end", "defTag": "marker", "onCreate": "marker", "animatable": true }
  ],

  "refUnitSpecs": [
    { "name": "clipPathUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "maskUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "maskContentUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "mask-type", "type": "select", "options": ["", "luminance", "alpha"] }
  ],

  "renderSpecs": [
    { "name": "visibility", "type": "select", "options": ["", "visible", "hidden", "collapse"], "animatable": true },
    { "name": "display", "type": "select", "options": ["", "inline", "block", "none"], "animatable": true },
    { "name": "overflow", "type": "select", "options": ["", "visible", "hidden", "scroll", "auto"] },
    { "name": "clip-rule", "type": "select", "options": ["", "nonzero", "evenodd"], "animatable": true },
    { "name": "shape-rendering", "type": "select", "options": ["", "auto", "optimizeSpeed", "crispEdges", "geometricPrecision"] },
    { "name": "text-rendering", "type": "select", "options": ["", "auto", "optimizeSpeed", "optimizeLegibility", "geometricPrecision"] },
    { "name": "image-rendering", "type": "select", "options": ["", "auto", "optimizeQuality", "optimizeSpeed", "pixelated", "smooth", "high-quality", "crisp-edges"] },
    { "name": "color-rendering", "type": "select", "options": ["", "auto", "optimizeSpeed", "optimizeQuality"] },
    { "name": "color-interpolation", "type": "select", "options": ["", "auto", "sRGB", "linearRGB"] },
    { "name": "color-profile", "type": "text" },
    { "name": "mix-blend-mode", "type": "select", "options": ["", "normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion", "hue", "saturation", "color", "luminosity"] },
    { "name": "isolation", "type": "select", "options": ["", "auto", "isolate"] },
    { "name": "style", "type": "textarea" },
    { "name": "requiredFeatures", "type": "text" },
    { "name": "requiredExtensions", "type": "text" },
    { "name": "systemLanguage", "type": "text" }
  ],

  "interactSpecs": [
    { "name": "class", "type": "text" },
    { "name": "pointer-events", "type": "select", "options": ["", "auto", "none", "visiblePainted", "visibleFill", "visibleStroke", "visible", "painted", "fill", "stroke", "all"], "animatable": true },
    { "name": "cursor", "type": "select", "options": ["", "auto", "default", "pointer", "move", "crosshair", "text", "wait", "help", "grab", "grabbing"], "animatable": true }
  ],

  "textBaseSpecs": [
    { "name": "text-anchor", "type": "select", "options": ["", "start", "middle", "end"], "animatable": true },
    { "name": "font-family", "type": "text", "animatable": true },
    { "name": "font-size", "type": "number", "animatable": true },
    { "name": "font-weight", "type": "select", "options": ["", "normal", "bold", "100", "200", "300", "400", "500", "600", "700", "800", "900"], "animatable": true },
    { "name": "font-style", "type": "select", "options": ["", "normal", "italic", "oblique"], "animatable": true },
    { "name": "letter-spacing", "type": "text", "animatable": true },
    { "name": "rotate", "type": "text", "animatable": true }
  ],

  "textAdvSpecs": [
    { "name": "dominant-baseline", "type": "select", "options": ["", "auto", "text-before-edge", "text-after-edge", "middle", "central", "hanging", "alphabetic", "ideographic", "mathematical", "inherit"], "animatable": true },
    { "name": "alignment-baseline", "type": "select", "options": ["", "auto", "baseline", "before-edge", "text-before-edge", "middle", "central", "after-edge", "text-after-edge", "ideographic", "alphabetic", "hanging", "mathematical", "inherit"], "animatable": true },
    { "name": "baseline-shift", "type": "text", "animatable": true },
    { "name": "text-decoration", "type": "select", "options": ["", "none", "underline", "overline", "line-through"], "animatable": true },
    { "name": "textLength", "type": "number", "animatable": true },
    { "name": "lengthAdjust", "type": "select", "options": ["", "spacing", "spacingAndGlyphs"], "animatable": true },
    { "name": "word-spacing", "type": "text", "animatable": true },
    { "name": "writing-mode", "type": "select", "options": ["", "horizontal-tb", "vertical-rl", "vertical-lr"] },
    { "name": "font-stretch", "type": "select", "options": ["", "normal", "ultra-condensed", "extra-condensed", "condensed", "semi-condensed", "semi-expanded", "expanded", "extra-expanded", "ultra-expanded"] },
    { "name": "xml:space", "type": "select", "options": ["", "default", "preserve"] },
    { "name": "font-variant", "type": "select", "options": ["", "normal", "small-caps", "all-small-caps", "petite-caps", "all-petite-caps", "unicase", "titling-caps"] },
    { "name": "font-feature-settings", "type": "text" },
    { "name": "kerning", "type": "text" }
  ],

  "textPathSpecs": [
    { "name": "href", "type": "text" },
    { "name": "method", "type": "select", "options": ["", "align", "stretch"] },
    { "name": "spacing", "type": "select", "options": ["", "auto", "exact"] },
    { "name": "side", "type": "select", "options": ["", "left", "right"] },
    { "name": "textLength", "type": "text" },
    { "name": "lengthAdjust", "type": "select", "options": ["", "spacing", "spacingAndGlyphs"] }
  ],

  "aSpecs": [
    { "name": "href", "type": "text" },
    { "name": "target", "type": "select", "options": ["", "_self", "_blank", "_parent", "_top"] },
    { "name": "download", "type": "text" },
    { "name": "rel", "type": "text" },
    { "name": "type", "type": "text", "labelKey": "attr.mimeType" },
    { "name": "hreflang", "type": "text" }
  ],

  "patternSpecs": [
    { "name": "href", "type": "text" },
    { "name": "x", "type": "text", "animatable": true },
    { "name": "y", "type": "text", "animatable": true },
    { "name": "width", "type": "text", "animatable": true },
    { "name": "height", "type": "text", "animatable": true },
    { "name": "viewBox", "type": "text" },
    { "name": "preserveAspectRatio", "type": "select", "options": ["", "none", "xMidYMid meet", "xMidYMid slice", "xMinYMin meet", "xMinYMin slice", "xMidYMin meet", "xMidYMin slice", "xMaxYMin meet", "xMaxYMin slice", "xMinYMid meet", "xMinYMid slice", "xMaxYMid meet", "xMaxYMid slice", "xMinYMax meet", "xMinYMax slice", "xMidYMax meet", "xMidYMax slice", "xMaxYMax meet", "xMaxYMax slice"] },
    { "name": "patternUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "patternContentUnits", "type": "select", "options": ["", "userSpaceOnUse", "objectBoundingBox"] },
    { "name": "patternTransform", "type": "text" }
  ],

  "symbolSpecs": [
    { "name": "viewBox", "type": "text" },
    { "name": "preserveAspectRatio", "type": "select", "options": ["", "none", "xMidYMid meet", "xMidYMid slice", "xMinYMin meet", "xMinYMin slice", "xMidYMin meet", "xMidYMin slice", "xMaxYMin meet", "xMaxYMin slice", "xMinYMid meet", "xMinYMid slice", "xMaxYMid meet", "xMaxYMid slice", "xMinYMax meet", "xMinYMax slice", "xMidYMax meet", "xMidYMax slice", "xMaxYMax meet", "xMaxYMax slice"] },
    { "name": "refX", "type": "text" },
    { "name": "refY", "type": "text" },
    { "name": "x", "type": "text" },
    { "name": "y", "type": "text" },
    { "name": "width", "type": "text" },
    { "name": "height", "type": "text" }
  ],

  "viewSpecs": [
    { "name": "viewBox", "type": "text" },
    { "name": "preserveAspectRatio", "type": "select", "options": ["", "none", "xMidYMid meet", "xMidYMid slice", "xMinYMin meet", "xMinYMin slice", "xMidYMin meet", "xMidYMin slice", "xMaxYMin meet", "xMaxYMin slice", "xMinYMid meet", "xMinYMid slice", "xMaxYMid meet", "xMaxYMid slice", "xMinYMax meet", "xMinYMax slice", "xMidYMax meet", "xMidYMax slice", "xMaxYMax meet", "xMaxYMax slice"] }
  ],

  "switchSpecs": [
    { "name": "requiredFeatures", "type": "text" },
    { "name": "requiredExtensions", "type": "text" },
    { "name": "systemLanguage", "type": "text" }
  ],

  "transformSpecs": [
    {
      "key": "tx", "labelKey": "field.translateX", "step": 1,
      "preset": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "translate", "values": "0,0;20,0;0,0", "dur": "2s", "repeatCount": "indefinite" }
      }
    },
    {
      "key": "ty", "labelKey": "field.translateY", "step": 1,
      "preset": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "translate", "values": "0,0;0,20;0,0", "dur": "2s", "repeatCount": "indefinite" }
      }
    },
    {
      "key": "rot", "labelKey": "field.rotation", "step": 1,
      "preset": {
        "kind": "animateTransform", "dynamic": "rotateCenter",
        "attrs": { "attributeName": "transform", "type": "rotate", "dur": "4s", "repeatCount": "indefinite" }
      }
    },
    { "key": "rotCx", "labelKey": "field.rotCenterX", "step": 1 },
    { "key": "rotCy", "labelKey": "field.rotCenterY", "step": 1 },
    {
      "key": "scale", "labelKey": "field.scale", "step": 0.1, "min": 0,
      "preset": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "scale", "values": "1;1.2;1", "dur": "2s", "repeatCount": "indefinite" }
      }
    },
    {
      "key": "skewX", "labelKey": "field.skewX", "step": 1,
      "preset": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "skewX", "values": "0;20;0", "dur": "2s", "repeatCount": "indefinite" }
      }
    },
    {
      "key": "skewY", "labelKey": "field.skewY", "step": 1,
      "preset": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "skewY", "values": "0;20;0", "dur": "2s", "repeatCount": "indefinite" }
      }
    }
  ],

  "canvasPresets": [
    { "key": "ratio16_9", "mode": "ratio", "ratio": 1.7778 },
    { "key": "ratio4_3", "mode": "ratio", "ratio": 1.3333 },
    { "key": "ratio1_1", "mode": "ratio", "ratio": 1 },
    { "key": "a4", "mode": "fixed", "width": 794, "height": 1123 },
    { "key": "size24", "mode": "square", "size": 24 },
    { "key": "size32", "mode": "square", "size": 32 },
    { "key": "size64", "mode": "square", "size": 64 },
    { "key": "size128", "mode": "square", "size": 128 },
    { "key": "size256", "mode": "square", "size": 256 }
  ],

  "presetColors": [
    "#000000", "#ffffff", "#64748b", "#94a3b8", "#ef4444", "#f97316",
    "#f59e0b", "#eab308", "#22c55e", "#14b8a6", "#3b82f6", "#8b5cf6"
  ],

  "vbLabels": ["minX", "minY", "width", "height"],

  "parOptions": [
    "", "xMidYMid meet", "xMidYMid slice", "none",
    "xMinYMin meet", "xMinYMin slice",
    "xMidYMin meet", "xMidYMin slice",
    "xMaxYMin meet", "xMaxYMin slice",
    "xMinYMid meet", "xMinYMid slice",
    "xMaxYMid meet", "xMaxYMid slice",
    "xMinYMax meet", "xMinYMax slice",
    "xMidYMax meet", "xMidYMax slice",
    "xMaxYMax meet", "xMaxYMax slice"
  ],

  "shapes": {
    "order": ["rect", "roundrect", "circle", "ellipse", "triangle", "polygon", "star", "line", "polyline"],
    "builders": {
      "rect": { "kind": "rect", "defaults": { "sizeRatio": 1.0 } },
      "roundrect": { "kind": "rect", "defaults": { "sizeRatio": 1.0, "rxRatio": 0.08 } },
      "circle": { "kind": "circle", "defaults": { "radiusRatio": 0.5 } },
      "ellipse": { "kind": "ellipse", "defaults": { "rxRatio": 0.5, "ryRatio": 0.35 } },
      "triangle": { "kind": "polygon", "defaults": { "sides": 3, "radiusRatio": 0.5 } },
      "polygon": { "kind": "polygon", "defaults": { "sides": 6, "radiusRatio": 0.5 } },
      "star": { "kind": "polygon-star", "defaults": { "points": 5, "ratio": 0.45, "radiusRatio": 0.5 } },
      "line": { "kind": "line", "defaults": { "lengthRatio": 1.0 } },
      "polyline": { "kind": "polyline", "defaults": { "sizeRatio": 1.0 } }
    }
  },

  "animTemplates": {
    "order": [
      "fade", "rotate", "scale", "translate", "color", "fillGradient",
      "pulse", "blink", "heartbeat", "shake", "bounce", "swing",
      "flip", "glow", "outline", "stroke", "drawPath", "dashFlow",
      "skewPulse", "motion", "custom"
    ],
    "builders": {
      "fade": {
        "kind": "animate",
        "attrs": { "attributeName": "opacity", "values": "1;0;1", "dur": "2s", "repeatCount": "indefinite" }
      },
      "rotate": {
        "kind": "animateTransform", "dynamic": "rotateCenter",
        "attrs": { "attributeName": "transform", "type": "rotate", "dur": "4s", "repeatCount": "indefinite", "additive": "sum" }
      },
      "scale": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "scale", "values": "1;1.2;1", "dur": "2s", "repeatCount": "indefinite" }
      },
      "translate": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "translate", "values": "0,0;20,0;0,0", "dur": "2s", "repeatCount": "indefinite" }
      },
      "color": {
        "kind": "animate",
        "attrs": { "attributeName": "fill", "values": "#ff0000;#00ff00;#ff0000", "dur": "3s", "repeatCount": "indefinite" }
      },
      "fillGradient": {
        "kind": "animate",
        "attrs": { "attributeName": "fill", "from": "#3b82f6", "to": "#ef4444", "dur": "2s", "fill": "freeze" }
      },
      "pulse": {
        "kind": "animate",
        "attrs": { "attributeName": "opacity", "values": "1;0.4;1", "dur": "1s", "repeatCount": "indefinite" }
      },
      "blink": {
        "kind": "animate",
        "attrs": { "attributeName": "opacity", "values": "1;0;1", "dur": "0.8s", "repeatCount": "indefinite" }
      },
      "heartbeat": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "scale", "values": "1;1.15;1;1.1;1", "dur": "1.2s", "repeatCount": "indefinite" }
      },
      "shake": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "translate", "values": "0,0;3,0;-3,0;2,0;-2,0;0,0", "dur": "0.4s", "repeatCount": "indefinite", "additive": "sum" }
      },
      "bounce": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "translate", "values": "0,0;0,-15;0,0", "dur": "0.6s", "repeatCount": "indefinite", "additive": "sum" }
      },
      "swing": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "rotate", "values": "-10;10;-10", "dur": "1s", "repeatCount": "indefinite", "additive": "sum" }
      },
      "flip": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "scale", "values": "1,1;-1,1;1,1", "dur": "2s", "repeatCount": "indefinite" }
      },
      "glow": {
        "kind": "animate",
        "attrs": { "attributeName": "stroke-width", "values": "1;4;1", "dur": "2s", "repeatCount": "indefinite" }
      },
      "outline": {
        "kind": "animate",
        "attrs": { "attributeName": "stroke-opacity", "values": "1;0.2;1", "dur": "1.5s", "repeatCount": "indefinite" }
      },
      "stroke": {
        "kind": "animate",
        "attrs": { "attributeName": "stroke-dashoffset", "from": "100", "to": "0", "dur": "2s", "fill": "freeze" }
      },
      "drawPath": {
        "kind": "animate",
        "attrs": { "attributeName": "stroke-dashoffset", "from": "1000", "to": "0", "dur": "2s", "fill": "freeze" }
      },
      "dashFlow": {
        "kind": "animate",
        "attrs": { "attributeName": "stroke-dashoffset", "from": "0", "to": "-20", "dur": "1s", "repeatCount": "indefinite" }
      },
      "skewPulse": {
        "kind": "animateTransform",
        "attrs": { "attributeName": "transform", "type": "skewX", "values": "0;15;0", "dur": "2s", "repeatCount": "indefinite", "additive": "sum" }
      },
      "motion": {
        "kind": "animateMotion",
        "attrs": { "path": "M0,0 C 20,-20 40,20 60,0", "dur": "4s", "repeatCount": "indefinite" }
      },
      "custom": {
        "kind": "animate",
        "attrs": { "attributeName": "", "dur": "2s", "repeatCount": "indefinite" },
        "isCustom": true
      }
    }
  },

  "fieldAnims": {
    "x": { "kind": "valuePulse", "delta": 20 },
    "y": { "kind": "valuePulse", "delta": 20 },
    "cx": { "kind": "valuePulse", "delta": 20 },
    "cy": { "kind": "valuePulse", "delta": 20 },
    "x1": { "kind": "valuePulse", "delta": 20 },
    "y1": { "kind": "valuePulse", "delta": 20 },
    "x2": { "kind": "valuePulse", "delta": 20 },
    "y2": { "kind": "valuePulse", "delta": 20 },
    "dx": { "kind": "valuePulse", "delta": 10 },
    "dy": { "kind": "valuePulse", "delta": 10 },
    "width": { "kind": "scalePulse", "factor": 1.3 },
    "height": { "kind": "scalePulse", "factor": 1.3 },
    "r": { "kind": "scalePulse", "factor": 1.3 },
    "rx": { "kind": "scalePulse", "factor": 1.3 },
    "ry": { "kind": "scalePulse", "factor": 1.3 },
    "fill": { "kind": "colorLoop" },
    "stroke": { "kind": "colorLoop" },
    "stop-color": { "kind": "colorLoop" },
    "opacity": { "kind": "opacityPulse" },
    "fill-opacity": { "kind": "opacityPulse" },
    "stroke-opacity": { "kind": "opacityPulse" },
    "stop-opacity": { "kind": "opacityPulse" },
    "stroke-width": { "kind": "scalePulse", "factor": 2 },
    "stroke-dashoffset": { "kind": "dashoffset" },
    "font-size": { "kind": "scalePulse", "factor": 1.3 }
  },

  "filterPrimitives": {
    "order": [
      "feGaussianBlur", "feDropShadow", "feFlood", "feMorphology",
      "feOffset", "feTile", "feImage", "feBlend", "feColorMatrix",
      "feComponentTransfer", "feConvolveMatrix", "feDisplacementMap",
      "feTurbulence", "feComposite", "feMerge"
    ],
    "defs": {
      "feGaussianBlur": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "stdDeviation", "type": "text", "default": "3", "placeholder": "3" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feDropShadow": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "dx", "type": "number", "default": 2 },
          { "name": "dy", "type": "number", "default": 2 },
          { "name": "stdDeviation", "type": "number", "default": 3 },
          { "name": "flood-color", "type": "color", "default": "#000000" },
          { "name": "flood-opacity", "type": "number", "default": 0.5, "step": 0.1 },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feFlood": {
        "fields": [
          { "name": "flood-color", "type": "color", "default": "#000000" },
          { "name": "flood-opacity", "type": "number", "default": 1, "step": 0.1 },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feMorphology": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "operator", "type": "select", "options": ["erode", "dilate"], "default": "erode" },
          { "name": "radius", "type": "text", "default": "1", "placeholder": "1" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feOffset": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "dx", "type": "number", "default": 4 },
          { "name": "dy", "type": "number", "default": 4 },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feTile": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feImage": {
        "fields": [
          { "name": "href", "type": "text", "default": "", "placeholder": "https://..." },
          { "name": "preserveAspectRatio", "type": "select", "options": ["", "none", "xMidYMid meet", "xMidYMid slice", "xMinYMin meet", "xMinYMin slice", "xMidYMin meet", "xMidYMin slice", "xMaxYMin meet", "xMaxYMin slice", "xMinYMid meet", "xMinYMid slice", "xMaxYMid meet", "xMaxYMid slice", "xMinYMax meet", "xMinYMax slice", "xMidYMax meet", "xMidYMax slice", "xMaxYMax meet", "xMaxYMax slice"] },
          { "name": "crossorigin", "type": "select", "options": ["", "anonymous", "use-credentials"] },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feBlend": {
        "fields": [
          { "name": "mode", "type": "select", "options": ["normal", "multiply", "screen", "overlay", "darken", "lighten"], "default": "normal" },
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "in2", "type": "text", "default": "", "placeholder": "in2" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feColorMatrix": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "type", "type": "select", "options": ["matrix", "saturate", "hueRotate", "luminanceToAlpha"], "default": "saturate", "labelKey": "attr.colorMatrixType" },
          { "name": "values", "type": "text", "default": "0.5", "placeholder": "0.5", "full": true },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feComponentTransfer": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feConvolveMatrix": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "order", "type": "text", "default": "3", "placeholder": "3" },
          { "name": "kernelMatrix", "type": "text", "default": "0 0 0 0 1 0 0 0 0", "placeholder": "0 0 0 0 1 0 0 0 0" },
          { "name": "divisor", "type": "number", "default": 1 },
          { "name": "bias", "type": "number", "default": 0 },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feDisplacementMap": {
        "fields": [
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "in2", "type": "text", "default": "", "placeholder": "in2" },
          { "name": "scale", "type": "number", "default": 0 },
          { "name": "xChannelSelector", "type": "select", "options": ["R", "G", "B", "A"], "default": "R" },
          { "name": "yChannelSelector", "type": "select", "options": ["R", "G", "B", "A"], "default": "R" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feTurbulence": {
        "fields": [
          { "name": "baseFrequency", "type": "text", "default": "0.05", "placeholder": "0.05" },
          { "name": "numOctaves", "type": "number", "default": 2 },
          { "name": "type", "type": "select", "options": ["fractalNoise", "turbulence"], "default": "fractalNoise", "labelKey": "attr.turbulenceType" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feComposite": {
        "fields": [
          { "name": "operator", "type": "select", "options": ["over", "in", "out", "atop", "xor"], "default": "over" },
          { "name": "in", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic" },
          { "name": "in2", "type": "text", "default": "", "placeholder": "in2" },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      },
      "feMerge": {
        "fields": [
          { "name": "inputs", "type": "text", "default": "SourceGraphic", "placeholder": "SourceGraphic, blur", "full": true },
          { "name": "result", "type": "text", "default": "", "placeholder": "result" }
        ]
      }
    }
  },

  "markerPresets": {
    "order": ["triangle", "circle", "vee"],
    "defs": {
      "triangle": {
        "viewBox": "0 0 10 10",
        "refX": 10, "refY": 5, "size": 10,
        "markup": "<path d=\"M0,0 L10,5 L0,10 z\" fill=\"{color}\"/>"
      },
      "circle": {
        "viewBox": "0 0 10 10",
        "refX": 5, "refY": 5, "size": 10,
        "markup": "<circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"{color}\"/>"
      },
      "vee": {
        "viewBox": "0 0 10 10",
        "refX": 8, "refY": 5, "size": 10,
        "markup": "<path d=\"M2,2 L8,5 L2,8\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>"
      }
    }
  }
}